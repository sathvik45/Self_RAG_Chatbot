GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
EMBEDDING_MODEL=ibm-granite/granite-embedding-107m-multilingual
HF_TOKEN=
# Set to true once the embedding model is cached locally, to skip the Hugging Face Hub freshness check on every startup.
HF_HUB_OFFLINE=false
DATA_DIR=data
INDEX_DIR=storage/faiss_index
RETRIEVAL_K=4
MAX_REVISE_TRIES=2
MAX_REWRITE_TRIES=2
RECURSION_LIMIT=150
